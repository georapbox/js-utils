
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "jest": true
  },
  "rules": {
    "no-empty": ["error", {
      "allowEmptyCatch": true
    }],
    "no-use-before-define": ["error", {
      "functions": false
    }],
    "eqeqeq": ["error", "always", {
      "null": "ignore"
    }],
    "curly": "warn",
    "no-var": "warn",
    "prefer-const": "warn",
    "prefer-rest-params": "warn"
  }
}
