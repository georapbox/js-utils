{
  "name": "js-utils",
  "version": "1.0.0",
  "type": "module",
  "description": "A collection of dependency-free JavaScript utilities.",
  "author": {
    "name": "George Raptis",
    "email": "georapbox@gmail.com"
  },
  "homepage": "https://github.com/georapbox/js-utils",
  "repository": {
    "type": "git",
    "url": "git@github.com:georapbox/js-utils.git"
  },
  "bugs": {
    "url": "https://github.com/georapbox/js-utils/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "fmt": "oxfmt \"**/*.js\"",
    "fmt:check": "oxfmt --check \"**/*.js\"",
    "docs": "node scripts/docs/generate.mjs"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "~5.1.0",
    "@vitest/coverage-v8": "~5.1.0",
    "@vitest/ui": "~5.1.0",
    "jsdoc-to-markdown": "~9.1.3",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.90.0",
    "vitest": "~5.1.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.17.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
