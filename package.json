{
  "name": "js-utils",
  "version": "1.0.0",
  "description": "A collection of dependency-free JavaScript utilities.",
  "author": "George Raptis <georapbox@gmail.com>",
  "homepage": "https://github.com/georapbox/js-utils",
  "repository": {
    "type": "git",
    "url": "git@github.com:georapbox/js-utils.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "lint": "oxlint packages",
    "fmt": "oxfmt \"**/*.js\"",
    "fmt:check": "oxfmt --check \"**/*.js\"",
    "docs": "npx jsdoc2md"
  },
  "devDependencies": {
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "jsdoc-to-markdown": "~9.0.0",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.90.0"
  }
}
